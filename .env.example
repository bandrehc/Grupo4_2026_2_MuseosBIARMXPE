# Copie este archivo a .env y cambie las dos contraseñas (no lo suba a ningún repositorio).
# SQL Server exige complejidad: 8+ caracteres con mayúscula, minúscula, número y símbolo.
SA_PASSWORD=CambiarEstaClave_1!
DASHLY_RO_PASSWORD=CambiarOtraClave_2!
# Carpeta del host con el .bak (solo lectura). Por defecto ./data
BAK_HOST_DIR=./data
